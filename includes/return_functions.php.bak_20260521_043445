            $purchaseItem = $db->getOne(
                "SELECT * FROM purchase_items WHERE id = :id AND purchase_id = :pid",
                [':id' => $item['purchase_item_id'], ':pid' => $purchaseId]
            );
            if (!$purchaseItem) throw new Exception("Purchase item not found");
            if ($item['quantity'] > $purchaseItem['quantity']) throw new Exception("Return quantity exceeds purchased quantity");
            
            // Update batch stock (deduct)
            $batch = $db->getOne("SELECT remaining_quantity FROM batches WHERE id = :bid FOR UPDATE", [':bid' => $purchaseItem['batch_id']]);
            if ($batch['remaining_quantity'] < $item['quantity']) throw new Exception("Insufficient stock in batch");
            $newQty = $batch['remaining_quantity'] - $item['quantity'];
            $db->run("UPDATE batches SET remaining_quantity = :nq WHERE id = :bid", [':nq' => $newQty, ':bid' => $purchaseItem['batch_id']]);
            
            $returnAmount = $item['quantity'] * $purchaseItem['unit_price'];
            $totalReturnAmount += $returnAmount;
            
            $returnId = insertData('purchase_returns', [
                'return_no' => $returnNo,
                'purchase_id' => $purchaseId,
                'purchase_item_id' => $purchaseItem['id'],
                'batch_id' => $purchaseItem['batch_id'],
                'quantity' => $item['quantity'],
                'unit_price' => $purchaseItem['unit_price'],
                'total_amount' => $returnAmount,
                'reason' => $reason,
                'refund_method' => 'cash',
                'returned_by' => $_SESSION['user_id']
            ]);
            
            insertData('stock_movements', [
                'batch_id' => $purchaseItem['batch_id'],
                'movement_type' => 'return_out',
                'quantity' => $item['quantity'],
                'reference_id' => $returnId,
                'reference_type' => 'purchase_return',
                'previous_quantity' => $batch['remaining_quantity'],
                'new_quantity' => $newQty,
                'created_by' => $_SESSION['user_id']
            ]);
            
            // Reduce supplier balance
            $db->run("UPDATE suppliers SET current_balance = GREATEST(0, current_balance - :amt) 
                      WHERE id = (SELECT supplier_id FROM purchases WHERE id = :pid)",
                      [':amt' => $returnAmount, ':pid' => $purchaseId]);
        }
        
        $db->run("UPDATE purchases SET total = total - :amt WHERE id = :pid", [':amt' => $totalReturnAmount, ':pid' => $purchaseId]);
        
        $db->commit();
        syncAfterPurchaseReturn($returnId ?? 0, $purchaseId, $purchaseItem['supplier_id'] ?? 0, $totalReturnAmount, $returnNo, 'cash');
        
        return ['success' => true, 'return_amount' => $totalReturnAmount];
    } catch (Exception $e) {
        $db->rollback();
        error_log("Purchase Return Error: " . $e->getMessage());
        return ['success' => false, 'message' => $e->getMessage()];
    }
}
