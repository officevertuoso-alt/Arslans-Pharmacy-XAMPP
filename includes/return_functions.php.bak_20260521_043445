// 5. PURCHASE RETURN SUMMARY
// ─────────────────────────────────────────────────────────
/**
 * Get summary of returns for a specific purchase.
 *
 * @param int $purchase_id
 * @return array ['total_returned_amount', 'return_count', 'net_amount']
 */
function getPurchaseReturnSummary($purchase_id) {
    $db = db();
    $result = $db->getOne(
        "SELECT 
            COALESCE(SUM(total_amount), 0) as total_returned,
            COUNT(DISTINCT id) as return_count
         FROM purchase_returns
         WHERE purchase_id = :pid",
        [':pid' => $purchase_id]
    );
    $totalReturned = (float)($result['total_returned'] ?? 0);
    $returnCount = (int)($result['return_count'] ?? 0);
    
    $purchase = $db->getOne("SELECT total FROM purchases WHERE id = :pid", [':pid' => $purchase_id]);
    $originalTotal = $purchase ? (float)$purchase['total'] : 0;
    $netAmount = $originalTotal - $totalReturned;
    
    return [
        'total_returned_amount' => $totalReturned,
        'return_count'          => $returnCount,
        'net_amount'            => max(0, $netAmount)
    ];
}

// ─────────────────────────────────────────────────────────
// 6. SALE RETURN DETAILS (single return)
// ─────────────────────────────────────────────────────────
/**
 * Get full details of a specific sale return.
 *
 * @param int $return_id
 * @return array|null Return details including items, cashbook entry status
 */
function getSaleReturnDetails($return_id) {
    $db = db();
    $return = $db->getOne(
        "SELECT sr.*, 
                s.invoice_no, s.customer_name, s.customer_phone,
                u.full_name as returned_by_name,
                p.product_name, p.generic_name,
                b.batch_number
         FROM sale_returns sr
         JOIN sales s ON sr.sale_id = s.id
         JOIN sale_items si ON sr.sale_item_id = si.id
         JOIN products p ON sr.product_id = p.id
         JOIN batches b ON sr.batch_id = b.id
         LEFT JOIN users u ON sr.returned_by = u.id
         WHERE sr.id = :rid",
        [':rid' => $return_id]
    );
    
    if (!$return) return null;
    
    // Check if cashbook entry exists for this return
    $cashbook = $db->getOne(
        "SELECT id, entry_type, debit, credit, payment_method 
         FROM cashbook 
         WHERE reference_id = :rid AND reference_type = 'sale_return'",
        [':rid' => $return_id]
    );
    $return['cashbook_entry_exists'] = ($cashbook !== null);
    $return['cashbook_amount'] = $cashbook ? (float)($cashbook['debit'] ?? 0) : 0;
    $return['cashbook_payment_method'] = $cashbook['payment_method'] ?? null;
    
    return $return;
}

