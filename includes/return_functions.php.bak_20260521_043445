// ─────────────────────────────────────────────────────────
// 10. RETURN STATS BY DATE (for dashboard)
// ─────────────────────────────────────────────────────────
/**
 * Get aggregated return statistics for a given date.
 *
 * @param string $date Y-m-d
 * @return array
 */
function getReturnStatsByDate($date) {
    $db = db();
    
    // Sale returns
    $saleStats = $db->getOne(
        "SELECT 
            COALESCE(SUM(total_amount), 0) as total_amount,
            COUNT(*) as count
         FROM sale_returns
         WHERE DATE(created_at) = :date",
        [':date' => $date]
    );
    
    // Purchase returns
    $purchaseStats = $db->getOne(
        "SELECT 
            COALESCE(SUM(total_amount), 0) as total_amount,
            COUNT(*) as count
         FROM purchase_returns
         WHERE DATE(created_at) = :date",
        [':date' => $date]
    );
    
    return [
        'sale_returns' => [
            'total_amount' => (float)($saleStats['total_amount'] ?? 0),
            'count' => (int)($saleStats['count'] ?? 0)
        ],
        'purchase_returns' => [
            'total_amount' => (float)($purchaseStats['total_amount'] ?? 0),
            'count' => (int)($purchaseStats['count'] ?? 0)
        ],
        'combined_total' => (float)($saleStats['total_amount'] ?? 0) + (float)($purchaseStats['total_amount'] ?? 0)
    ];
}

