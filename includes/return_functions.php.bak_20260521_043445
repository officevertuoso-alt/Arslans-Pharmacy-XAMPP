// ─────────────────────────────────────────────────────────
// 1. GET SALE FOR RETURN (allow paid AND partial payment)
// ─────────────────────────────────────────────────────────
/**
 * Get sale details including items with returnable quantities.
 *
 * @param mixed $identifier Sale ID or invoice number
 * @param bool  $isId       True if identifier is ID, false if invoice_no
 * @return array|null Sale data with items and already_returned info
 */
function getSaleForReturn($identifier, $isId = true) {
    $db = db();
    
    // Allow both 'paid' and 'partial' payment_status
    if ($isId) {
        $sale = $db->getOne(
            "SELECT s.*, c.id as credit_id, c.total_amount as credit_total, c.status as credit_status
             FROM sales s
             LEFT JOIN customer_credits c ON c.sale_id = s.id
             WHERE s.id = :id AND s.payment_status IN ('paid', 'partial')
               AND s.status != 'voided'",
            [':id' => $identifier]
        );
    } else {
        $sale = $db->getOne(
            "SELECT s.*, c.id as credit_id, c.total_amount as credit_total, c.status as credit_status
             FROM sales s
             LEFT JOIN customer_credits c ON c.sale_id = s.id
             WHERE s.invoice_no = :inv AND s.payment_status IN ('paid', 'partial')
               AND s.status != 'voided'",
            [':inv' => $identifier]
        );
    }
    
    if (!$sale) {
        return null;
    }
    
    // Get sale items with batch details and already returned quantity
    $items = $db->getAll(
        "SELECT 
            si.id as sale_item_id,
            si.product_id,
            si.variant_id,
            si.batch_id,
            si.quantity as sold_quantity,
            si.unit_price,
            si.total as line_total,
            b.batch_number,
            b.expiry_date,
            b.remaining_quantity as batch_stock,
            p.product_name,
            p.generic_name,
            p.brand_name,
            v.variant_value,
            COALESCE((
                SELECT SUM(sr.quantity) 
                FROM sale_returns sr 
                WHERE sr.sale_item_id = si.id
            ), 0) as already_returned
        FROM sale_items si
        JOIN batches b ON si.batch_id = b.id
        JOIN products p ON si.product_id = p.id
        LEFT JOIN product_variants v ON si.variant_id = v.id
        WHERE si.sale_id = :sale_id
        ORDER BY si.id",
        [':sale_id' => $sale['id']]
    );
    
    // Calculate returnable quantity for each item
    foreach ($items as &$item) {
        $item['returnable_qty'] = max(0, $item['sold_quantity'] - $item['already_returned']);
        $item['max_returnable'] = $item['returnable_qty'];
        $item['line_total'] = (float)$item['line_total'];
        $item['unit_price'] = (float)$item['unit_price'];
    }
    
    $sale['items'] = $items;
    $sale['grand_total'] = (float)$sale['grand_total'];
    $sale['paid_amount'] = (float)$sale['paid_amount'];
    $sale['net_amount'] = (float)$sale['net_amount'];
    
    return $sale;
}

// ─────────────────────────────────────────────────────────
// 2. GET PURCHASE FOR RETURN (with already returned)
// ─────────────────────────────────────────────────────────
/**
 * Get purchase details including items with returnable quantities.
 *
 * @param mixed $identifier Purchase ID or invoice number
 * @param bool  $isId       True if identifier is ID, false if purchase_invoice_no
 * @return array|null Purchase data with items and already_returned info
 */
function getPurchaseForReturn($identifier, $isId = true) {
    $db = db();
    
    if ($isId) {
        $purchase = $db->getOne(
            "SELECT p.*, s.supplier_name, s.current_balance, s.due_amount
             FROM purchases p
             JOIN suppliers s ON p.supplier_id = s.id
             WHERE p.id = :id AND p.status != 'voided'",
            [':id' => $identifier]
        );
    } else {
        $purchase = $db->getOne(
            "SELECT p.*, s.supplier_name, s.current_balance, s.due_amount
             FROM purchases p
             JOIN suppliers s ON p.supplier_id = s.id
             WHERE p.purchase_invoice_no = :inv AND p.status != 'voided'",
            [':inv' => $identifier]
        );
    }
    
    if (!$purchase) {
        return null;
    }
    
    // Get purchase items with batch details and already returned quantity
    $items = $db->getAll(
        "SELECT 
            pi.id as purchase_item_id,
            pi.product_id,
            pi.variant_id,
            pi.batch_id,
            pi.quantity as purchased_quantity,
            pi.unit_price,
            pi.total as line_total,
            b.batch_number,
            b.expiry_date,
            b.remaining_quantity as batch_stock,
            p.product_name,
            p.generic_name,
            p.brand_name,
            v.variant_value,
            COALESCE((
                SELECT SUM(pr.quantity) 
                FROM purchase_returns pr 
                WHERE pr.purchase_item_id = pi.id
            ), 0) as already_returned
        FROM purchase_items pi
        JOIN batches b ON pi.batch_id = b.id
        JOIN products p ON pi.product_id = p.id
        LEFT JOIN product_variants v ON pi.variant_id = v.id
        WHERE pi.purchase_id = :purchase_id
        ORDER BY pi.id",
        [':purchase_id' => $purchase['id']]
    );
    
    foreach ($items as &$item) {
        $item['returnable_qty'] = max(0, $item['purchased_quantity'] - $item['already_returned']);
        $item['max_returnable'] = $item['returnable_qty'];
        $item['line_total'] = (float)$item['line_total'];
        $item['unit_price'] = (float)$item['unit_price'];
    }
    
    $purchase['items'] = $items;
    $purchase['total'] = (float)$purchase['total'];
    $purchase['paid_amount'] = (float)$purchase['paid_amount'];
    $purchase['due_amount'] = (float)$purchase['due_amount'];
    
    return $purchase;
}

// ─────────────────────────────────────────────────────────
// 3. RETURNABLE ITEMS HELPER (for reusable logic)
// ─────────────────────────────────────────────────────────
/**
 * Get returnable items for a sale or purchase.
 *
 * @param int    $parentId Sale or Purchase ID
 * @param string $type     'sale' or 'purchase'
 * @return array  List of items with qty_sold, qty_already_returned, qty_returnable
 */
function getReturnableItems($parentId, $type = 'sale') {
    $db = db();
    if ($type === 'sale') {
        $items = $db->getAll(
            "SELECT 
                si.id as item_id,
                si.product_id,
                si.batch_id,
                si.quantity as sold_qty,
                si.unit_price,
                p.product_name,
                b.batch_number,
                COALESCE(SUM(sr.quantity), 0) as returned_qty
            FROM sale_items si
            JOIN products p ON si.product_id = p.id
            JOIN batches b ON si.batch_id = b.id
            LEFT JOIN sale_returns sr ON sr.sale_item_id = si.id
            WHERE si.sale_id = :pid
            GROUP BY si.id",
            [':pid' => $parentId]
        );
    } else {
        $items = $db->getAll(
            "SELECT 
                pi.id as item_id,
                pi.product_id,
                pi.batch_id,
                pi.quantity as purchased_qty,
                pi.unit_price,
                p.product_name,
                b.batch_number,
                COALESCE(SUM(pr.quantity), 0) as returned_qty
            FROM purchase_items pi
            JOIN products p ON pi.product_id = p.id
            JOIN batches b ON pi.batch_id = b.id
            LEFT JOIN purchase_returns pr ON pr.purchase_item_id = pi.id
            WHERE pi.purchase_id = :pid
            GROUP BY pi.id",
            [':pid' => $parentId]
        );
    }
    
    foreach ($items as &$item) {
        $item['qty_returnable'] = $item[$type === 'sale' ? 'sold_qty' : 'purchased_qty'] - $item['returned_qty'];
    }
    
    // Filter out items with zero returnable qty
    return array_filter($items, fn($i) => $i['qty_returnable'] > 0);
}

// ─────────────────────────────────────────────────────────
// 4. SALE RETURN SUMMARY
// ─────────────────────────────────────────────────────────
/**
 * Get summary of returns for a specific sale.
 *
 * @param int $sale_id
 * @return array ['total_returned_amount', 'return_count', 'net_amount']
 */
function getSaleReturnSummary($sale_id) {
    $db = db();
    $result = $db->getOne(
        "SELECT 
            COALESCE(SUM(total_amount), 0) as total_returned,
            COUNT(DISTINCT id) as return_count
         FROM sale_returns
         WHERE sale_id = :sid",
        [':sid' => $sale_id]
    );
    $totalReturned = (float)($result['total_returned'] ?? 0);
    $returnCount = (int)($result['return_count'] ?? 0);
    
    // Get sale net amount (original grand_total minus returns)
    $sale = $db->getOne("SELECT grand_total FROM sales WHERE id = :sid", [':sid' => $sale_id]);
    $grandTotal = $sale ? (float)$sale['grand_total'] : 0;
    $netAmount = $grandTotal - $totalReturned;
    
    return [
        'total_returned_amount' => $totalReturned,
        'return_count'          => $returnCount,
        'net_amount'            => max(0, $netAmount)
    ];
}

