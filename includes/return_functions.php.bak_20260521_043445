// ─────────────────────────────────────────────────────────
/**
 * Process sale return (legacy wrapper, but now uses sync_engine and cashbook).
 * For new code, use ajax/process_return.php instead.
 *
 * @deprecated Use ajax/process_return.php endpoint.
 */
function processSaleReturn($saleId, $items, $reason) {
    error_log("processSaleReturn() is deprecated. Use unified return processor.");
    $db = db();
    $db->beginTransaction();
    
    try {
        $totalReturnAmount = 0;
        $returnNo = 'SR-' . date('Ymd') . '-' . str_pad(rand(1, 9999), 4, '0', STR_PAD_LEFT);
        
        foreach ($items as $item) {
            if ($item['quantity'] <= 0) continue;
            
            // Get sale item
            $saleItem = $db->getOne(
                "SELECT * FROM sale_items WHERE id = :id AND sale_id = :sid",
                [':id' => $item['sale_item_id'], ':sid' => $saleId]
            );
            if (!$saleItem) throw new Exception("Sale item not found");
            if ($item['quantity'] > $saleItem['quantity']) throw new Exception("Return quantity exceeds sold quantity");
            
            // Update batch stock (restore)
            $batch = $db->getOne("SELECT remaining_quantity FROM batches WHERE id = :bid FOR UPDATE", [':bid' => $saleItem['batch_id']]);
            $newQty = $batch['remaining_quantity'] + $item['quantity'];
            $db->run("UPDATE batches SET remaining_quantity = :nq WHERE id = :bid", [':nq' => $newQty, ':bid' => $saleItem['batch_id']]);
            
            $returnAmount = $item['quantity'] * $saleItem['unit_price'];
            $totalReturnAmount += $returnAmount;
            
            // Insert sale_return
            $returnId = insertData('sale_returns', [
                'return_no' => $returnNo,
                'sale_id' => $saleId,
                'sale_item_id' => $saleItem['id'],
                'batch_id' => $saleItem['batch_id'],
                'quantity' => $item['quantity'],
                'unit_price' => $saleItem['unit_price'],
                'total_amount' => $returnAmount,
                'reason' => $reason,
                'refund_method' => 'cash',
                'returned_by' => $_SESSION['user_id']
            ]);
            
            // Stock movement
            insertData('stock_movements', [
                'batch_id' => $saleItem['batch_id'],
                'movement_type' => 'return_in',
                'quantity' => $item['quantity'],
                'reference_id' => $returnId,
                'reference_type' => 'sale_return',
                'previous_quantity' => $batch['remaining_quantity'],
                'new_quantity' => $newQty,
                'created_by' => $_SESSION['user_id']
            ]);
        }
        
        // Update sale net amount
        $db->run("UPDATE sales SET net_amount = net_amount - :amt WHERE id = :sid", [':amt' => $totalReturnAmount, ':sid' => $saleId]);
        
        $db->commit();
        // Sync engine call for backward compatibility
        syncAfterSaleReturn($returnId ?? 0, $saleId, $totalReturnAmount, 'cash', $returnNo);
        
        return ['success' => true, 'return_amount' => $totalReturnAmount];
    } catch (Exception $e) {
        $db->rollback();
        error_log("Sale Return Error: " . $e->getMessage());
        return ['success' => false, 'message' => $e->getMessage()];
    }
}

