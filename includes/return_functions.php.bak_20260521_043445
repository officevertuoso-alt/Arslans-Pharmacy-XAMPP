// ─────────────────────────────────────────────────────────
// 8. GET ALL SALE RETURNS (enhanced with filters)
// ─────────────────────────────────────────────────────────
/**
 * Get paginated list of sale returns with filters.
 *
 * @param int    $page
 * @param int    $perPage
 * @param string $search      Search by return_no, invoice_no, customer_name
 * @param string $fromDate    Y-m-d (optional)
 * @param string $toDate      Y-m-d (optional)
 * @param string $refundMethod (optional) cash/credit_note/bank
 * @return array
 */
function getAllSaleReturns($page = 1, $perPage = 20, $search = '', $fromDate = '', $toDate = '', $refundMethod = '') {
    $db = db();
    $offset = ($page - 1) * $perPage;
    
    $where = "1";
    $params = [];
    
    if (!empty($search)) {
        $where .= " AND (sr.return_no LIKE :search OR s.invoice_no LIKE :search OR s.customer_name LIKE :search)";
        $params[':search'] = "%$search%";
    }
    if (!empty($fromDate)) {
        $where .= " AND DATE(sr.created_at) >= :from";
        $params[':from'] = $fromDate;
    }
    if (!empty($toDate)) {
        $where .= " AND DATE(sr.created_at) <= :to";
        $params[':to'] = $toDate;
    }
    if (!empty($refundMethod) && in_array($refundMethod, ['cash', 'credit_note', 'bank'])) {
        $where .= " AND sr.refund_method = :method";
        $params[':method'] = $refundMethod;
    }
    
    // Main query with all fields
    $sql = "SELECT 
                sr.id,
                sr.return_no,
                sr.sale_id,
                sr.quantity,
                sr.unit_price,
                sr.total_amount,
                sr.reason,
                sr.refund_method,
                sr.created_at,
                s.invoice_no,
                s.customer_name,
                p.product_name,
                u.full_name as returned_by,
                (SELECT COUNT(*) FROM cashbook WHERE reference_id = sr.id AND reference_type = 'sale_return') as has_cashbook
            FROM sale_returns sr
            JOIN sales s ON sr.sale_id = s.id
            JOIN sale_items si ON sr.sale_item_id = si.id
            JOIN products p ON sr.product_id = p.id
            LEFT JOIN users u ON sr.returned_by = u.id
            WHERE $where
            ORDER BY sr.created_at DESC
            LIMIT " . (int)$offset . ", " . (int)$perPage;
    
    $returns = $db->getAll($sql, $params);
    
    // Get total count
    $countSql = "SELECT COUNT(DISTINCT sr.id) as total FROM sale_returns sr
                 JOIN sales s ON sr.sale_id = s.id
                 WHERE $where";
    $totalRow = $db->getOne($countSql, $params);
    $total = $totalRow ? (int)$totalRow['total'] : 0;
    
    return [
        'data' => $returns,
        'total' => $total,
        'page' => $page,
        'perPage' => $perPage,
        'totalPages' => ceil($total / $perPage)
    ];
}

