# =============================================
# Pharmacy Management System - Pakistan Edition
# Environment Configuration File
# =============================================
# INSTRUCTIONS:
#   1. Is file ko copy karke naam ".env" rakhein
#   2. Apni settings ke mutabiq values update karein
#   3. .env file KABHI bhi Git/version control mein commit mat karein
# =============================================

# Database Settings
DB_HOST=localhost
DB_NAME=pharmacy_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application Environment
# 'development' = errors show honge, slow query log on
# 'production'  = errors off, PHP log file mein jayenge
APP_ENV=production

# Slow Query Threshold (seconds) — sirf development mein use hoga
# 0.1 = 100ms se zyada wali queries log hongi
SLOW_QUERY_THRESHOLD=0.1
